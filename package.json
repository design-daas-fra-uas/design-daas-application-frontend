    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"*.{js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" \"*.{js,json,md}\""
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "axios": "^1.21.0",
    "bootstrap": "^5.3.8",
    "formik": "^2.4.9",
    "i18next": "^26.7.2",
    "react": "^19.3.1",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.13",
    "react-responsive": "^10.0.1",
    "react-router": "^7.18.5",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
